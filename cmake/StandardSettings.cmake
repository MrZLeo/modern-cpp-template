option(${PROJECT_NAME}_BUILD_EXECUTABLE "Build the example executable alongside the library." OFF)
option(${PROJECT_NAME}_BUILD_HEADERS_ONLY "Provide the library as an INTERFACE/header-only target." OFF)
option(${PROJECT_NAME}_ENABLE_UNIT_TESTING "Build tests with Catch2." ${PROJECT_IS_TOP_LEVEL})
option(${PROJECT_NAME}_WARNINGS_AS_ERRORS "Treat project compiler warnings as errors." OFF)
option(${PROJECT_NAME}_ENABLE_CLANG_TIDY "Analyze project library and application sources with clang-tidy." OFF)
option(${PROJECT_NAME}_ENABLE_CPPCHECK "Analyze project library and application sources with cppcheck." OFF)
option(${PROJECT_NAME}_ENABLE_CODE_COVERAGE "Instrument the library, application and tests for coverage." OFF)
option(${PROJECT_NAME}_ENABLE_DOXYGEN "Add the doxygen-docs target." OFF)
option(${PROJECT_NAME}_ENABLE_LTO "Enable interprocedural optimization." OFF)
option(${PROJECT_NAME}_ENABLE_CCACHE "Use ccache unless a compiler launcher is explicitly set." ON)
option(${PROJECT_NAME}_ENABLE_ASAN "Enable AddressSanitizer." OFF)

if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE)
  set(CACHE{CMAKE_BUILD_TYPE} TYPE STRING HELP "Build configuration" FORCE VALUE Debug)
endif()
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/lib/$<CONFIG>")
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/lib/$<CONFIG>")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${PROJECT_BINARY_DIR}/bin/$<CONFIG>")

# Keep exceptions and the platform-default runtime. Users can select the MSVC
# runtime with CMAKE_MSVC_RUNTIME_LIBRARY before any dependency targets exist.
if(MSVC)
  add_compile_options(/Zc:preprocessor /Zc:__cplusplus)
endif()
if(${PROJECT_NAME}_ENABLE_CCACHE AND NOT DEFINED CMAKE_CXX_COMPILER_LAUNCHER)
  find_program(CCACHE ccache)
  if(CCACHE)
    set(CMAKE_CXX_COMPILER_LAUNCHER "${CCACHE}")
  endif()
endif()
if(${PROJECT_NAME}_ENABLE_LTO)
  include(CheckIPOSupported)
  check_ipo_supported(RESULT ipo_supported OUTPUT ipo_error LANGUAGES CXX)
  if(NOT ipo_supported)
    message(FATAL_ERROR "IPO is not supported: ${ipo_error}")
  endif()
  set(CMAKE_INTERPROCEDURAL_OPTIMIZATION ON)
endif()
if(${PROJECT_NAME}_ENABLE_CODE_COVERAGE AND NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  message(FATAL_ERROR "Code coverage requires GCC or Clang.")
endif()
if(${PROJECT_NAME}_ENABLE_ASAN)
  if(MSVC)
    add_compile_options(/fsanitize=address)
  else()
    add_compile_options(-fsanitize=address)
    add_link_options(-fsanitize=address)
  endif()
endif()
